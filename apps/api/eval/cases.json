      }
    },
    {
      "id": "code-switch-heavy",
      "tests": "Dense code-switching within single sentences, which is the normal register rather than an edge case.",
      "tags": [
        "hinglish",
        "language"
      ],
      "channel": "whatsapp",
      "utterances": [
        {
          "text": "yaar there's been a major accident on the ORR near Gachibowli exit"
