# Copy to .env and fill in. Never commit .env.
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Supabase: use the SESSION pooler on port 5432, not the transaction pooler on 6543.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

PORT=5000
LOG_LEVEL=info

# --- Secrets --------------------------------------------------------------
# Generate with: npm run db:salt
CALLER_NUMBER_SALT=

# Interim operator identity, as `token:operatorId` pairs, comma separated.
# Replaced by real authentication in M7 — but an override trail that cannot
# say who overrode is worthless, so identity is required from the start.
OPERATOR_TOKENS=

# --- Channels -------------------------------------------------------------
# A channel with no signing secret is REFUSED, never served unverified.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

TWILIO_AUTH_TOKEN=
# The public URL Twilio signs against. Configured, not reconstructed: behind a
# TLS-terminating proxy the URL Node sees is http:// while Twilio signed https://.
PUBLIC_URL=

# --- Extraction -----------------------------------------------------------
# Omit to run on keyword matching: every incident becomes low-confidence and
# is escalated to a human.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_EFFORT=medium

# --- Operations -----------------------------------------------------------
RETENTION_DAYS=90
REFERENCE_PREFIX=IN

# --- OpenAI-compatible extraction ------------------------------------------
# Set the key with: npm run set-secret EXTRACTION_API_KEY
# Verify what an endpoint actually supports: npm run extraction:probe
#
# OpenCode has TWO gateways and they are not interchangeable:
#   Go subscription  https://opencode.ai/zen/go/v1   <- the $10/mo plan
#   Zen pay-as-you-go https://opencode.ai/zen/v1     <- needs workspace credit
# A Go key against the Zen path returns "Insufficient balance", which reads as
# a billing problem when it is actually the wrong URL.
EXTRACTION_PROVIDER=auto
EXTRACTION_BASE_URL=https://opencode.ai/zen/go/v1
EXTRACTION_API_KEY=
EXTRACTION_MODEL=deepseek-v4-flash
